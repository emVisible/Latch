{
  "name": "openstrat",
  "version": 1,
  "policy": "unique",
  "maxRounds": 4,
  "routingAtoms": [
    "diff.useEffect",
    "diff.tabKeepalive",
    "diff.earlyReturnToTernary",
    "diff.moduleConstCamel",
    "paths.charts"
  ],
  "resultAtoms": {
    "run.discipline.ok": {
      "from": "domain",
      "domain": "openstrat-change-discipline",
      "field": "ok"
    },
    "slot.answered": {
      "from": "slot",
      "slot": "style-drift",
      "field": "answered"
    },
    "slot.pass": {
      "from": "slot",
      "slot": "style-drift",
      "field": "pass"
    }
  },
  "constraints": ["slot.pass => slot.answered"],
  "molecules": {
    "disciplineBreach": {
      "any": [
        "diff.useEffect",
        "diff.tabKeepalive",
        "diff.earlyReturnToTernary",
        "diff.moduleConstCamel"
      ]
    }
  },
  "stages": {
    "entry": {
      "scope": [
        "diff.useEffect",
        "diff.tabKeepalive",
        "diff.earlyReturnToTernary",
        "diff.moduleConstCamel",
        "paths.charts"
      ],
      "links": [
        {
          "id": "stop-discipline",
          "when": "disciplineBreach",
          "to": {
            "kind": "stop",
            "exit": 1,
            "reason": "diff 违反改动纪律"
          }
        },
        {
          "id": "charts",
          "when": {
            "all": ["paths.charts", { "not": "disciplineBreach" }]
          },
          "to": {
            "kind": "run",
            "domain": "openstrat-change-discipline",
            "then": "after-discipline"
          }
        },
        {
          "id": "default",
          "when": {
            "all": [{ "not": "paths.charts" }, { "not": "disciplineBreach" }]
          },
          "to": {
            "kind": "run",
            "domain": "openstrat-change-discipline",
            "then": "after-discipline"
          }
        }
      ]
    },
    "after-discipline": {
      "scope": ["run.discipline.ok", "slot.answered", "slot.pass"],
      "links": [
        {
          "id": "discipline-failed",
          "when": { "not": "run.discipline.ok" },
          "to": {
            "kind": "stop",
            "exit": 1,
            "reason": "纪律域未通过"
          }
        },
        {
          "id": "slot-pending",
          "when": {
            "all": ["run.discipline.ok", { "not": "slot.answered" }]
          },
          "to": {
            "kind": "ask",
            "slot": "style-drift",
            "then": "after-discipline"
          }
        },
        {
          "id": "slot-failed",
          "when": {
            "all": [
              "run.discipline.ok",
              "slot.answered",
              { "not": "slot.pass" }
            ]
          },
          "to": {
            "kind": "stop",
            "exit": 1,
            "reason": "style-drift 判定为 fail"
          }
        },
        {
          "id": "done",
          "when": {
            "all": ["run.discipline.ok", "slot.answered", "slot.pass"]
          },
          "to": {
            "kind": "stop",
            "exit": 0,
            "reason": "route 完成"
          }
        }
      ]
    }
  }
}
